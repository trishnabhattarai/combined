<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrisystem.controller.farmer.FarmerFieldsController"
      styleClass="page-content" spacing="24">
    <padding><Insets top="32" bottom="32" left="32" right="32"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Manage Fields" styleClass="page-title"/>
            <Label text="View and manage your registered farm fields." styleClass="page-subtitle"/>
        </VBox>
        <Label fx:id="fieldCountLabel" styleClass="balance-badge"/>
        <Button fx:id="addFieldBtn" text="+ Add Field" styleClass="btn-primary" onAction="#addField"/>
    </HBox>

    <!-- Field Grid -->
    <GridPane fx:id="fieldGrid" hgap="16" vgap="16" VBox.vgrow="ALWAYS">
        <!-- Populated dynamically -->
    </GridPane>

    <!-- Pagination -->
    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="prevBtn" text="← Previous" styleClass="btn-secondary" onAction="#prevPage" disable="true"/>
        <Label fx:id="pageLabel" styleClass="muted-text"/>
        <Button fx:id="nextBtn" text="Next →" styleClass="btn-secondary" onAction="#nextPage"/>
    </HBox>


</VBox>
